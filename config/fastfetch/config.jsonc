{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/test.txt",
        "color": {
            "1": "#b4befe"
        }
    },

    "display": {
        "separator": " "
    },

    "modules": [
        {
            "type": "title",
            "keyWidth": 10,
            "color": {
              "user": "#b4befe",
              "at": "#cba6f7",
              "host": "#b4befe"
            }
        },
        {
            "type": "custom",
            "format": "",
            "keyColor": "#b4befe"
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "#b4befe"
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "#b4befe"
        },
        {
            "type": "packages",
            "key": "~ ",
            "keyColor": "#b4befe"
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "#b4befe"
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "#b4befe"
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "#b4befe"
        },
        "break",
        {
          "type": "colors",
          "key": "  ",
          "symbol": "circle"
        }
    ]
}

